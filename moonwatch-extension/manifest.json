{
  "manifest_version": 3,
  "name": "Moonwatch Stealth Sync",
  "version": "1.0",
  "description": "Invisible syncing bridge for Moonwatch Watch Parties.",
  "permissions": ["activeTab", "scripting", "webNavigation"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["iframe_spy.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost:5173/*", "https://*.vercel.app/*"],
      "js": ["react_bridge.js"],
      "run_at": "document_idle"
    }
  ]
}